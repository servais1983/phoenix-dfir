# Phoenix DFIR - Production environment template
# Copy this file to .env, then adjust the values.
# Never commit .env (it is ignored by .gitignore).

# === JWT secret (REQUIRED in production) ===
# Generate a long key: python -c "import secrets; print(secrets.token_hex(64))"
PHOENIX_SECRET_KEY=

# Refuse to start without PHOENIX_SECRET_KEY (recommended in production)
PHOENIX_ENV=production

# === Accounts ===
# Initial admin created at startup when the users table is empty. Without it,
# a one-time setup token is printed in the server logs and must be entered in
# the first registration form (that account becomes admin).
# PHOENIX_ADMIN_USERNAME=admin
# PHOENIX_ADMIN_PASSWORD=
# Public self-registration (new accounts get the read-only "viewer" role)
PHOENIX_ALLOW_REGISTRATION=false
# Failed logins per username before a 15 min lockout
# PHOENIX_LOGIN_LOCKOUT_THRESHOLD=10
# Concurrent autonomous investigations per user
# PHOENIX_MAX_JOBS_PER_USER=2

# === Reverse proxy ===
# Number of trusted proxies in front of the app. 0 = X-Forwarded-For ignored
# (clients cannot spoof their IP to bypass rate limiting). The bundled nginx
# (docker-compose.prod.yml) needs 1.
PHOENIX_TRUSTED_PROXIES=1
# Refresh cookie "Secure" flag: automatic over HTTPS (X-Forwarded-Proto with
# PHOENIX_TRUSTED_PROXIES), force it here if TLS terminates elsewhere.
# PHOENIX_COOKIE_SECURE=true

# === Metrics ===
# If set, /metrics requires "Authorization: Bearer <token>" (Prometheus:
# authorization.credentials). /livez and /readyz stay public.
# PHOENIX_METRICS_TOKEN=

# === Tokens v4 ===
# Access token lifetime (seconds), default 900 = 15 min
PHOENIX_ACCESS_TOKEN_EXPIRY=900
# Refresh token lifetime (seconds), default 604800 = 7 days
PHOENIX_REFRESH_TOKEN_EXPIRY=604800
# v3 backward compatibility: if set, overrides ACCESS_TOKEN_EXPIRY
# PHOENIX_TOKEN_EXPIRY=86400

# === Password hashing ===
# PBKDF2 iterations, increase as hardware improves
PHOENIX_PBKDF2_ITERATIONS=600000

# === Logging ===
# DEBUG, INFO, WARNING, ERROR
PHOENIX_LOG_LEVEL=INFO

# === Distributed cache and rate limiting ===
# If empty, falls back to in-memory (not recommended with multiple workers)
# REDIS_URL=redis://redis:6379/0

# === AI analysis: GitHub Copilot (GitHub Models API) ===
# GitHub token (fine-grained PAT with the "Models: read" permission,
# https://github.com/settings/tokens). GitHub Models access is included
# with GitHub accounts and Copilot subscriptions. Without a token, AI analysis
# is unavailable (the standalone native parsers keep working).
# GITHUB_TOKEN=
# Model to use (catalog: https://github.com/marketplace/models)
# PHOENIX_GITHUB_MODEL=openai/gpt-4o-mini

# === Investigator hybrid LLM ===
# auto (Docker default): local Ollama if reachable (no data leaves the
# network), otherwise OpenAI if OPENAI_API_KEY is set, otherwise GitHub Copilot.
# Force a provider: github | ollama | openai
# PHOENIX_LLM_PROVIDER=auto
# OPENAI_API_KEY=
# PHOENIX_OPENAI_MODEL=gpt-4o-mini
# Ollama: install on the host (https://ollama.com), then
#   ollama pull qwen2.5-coder:14b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# PHOENIX_OLLAMA_MODEL=qwen2.5-coder:14b

# Strict structured output: each finding must cite a RecordID, PID or line
# actually extracted by a tool (true by default)
# PHOENIX_STRICT_EVIDENCE=true

# === Evidence vault (mounted read-only at /mnt/evidence) ===
# Host folder containing the original evidence (EVTX, $MFT, RAM dumps)
# PHOENIX_EVIDENCE_VAULT_HOST=./evidence_vault
# Install Volatility 3 and Hayabusa in the Docker image (default true)
# PHOENIX_INSTALL_DFIR_TOOLS=true
# Offline Volatility: symbol tables folder
# PHOENIX_VOLATILITY_SYMBOLS=

# === Debug mode (NEVER true in production) ===
PHOENIX_DEBUG=false

# === Server port (single container) ===
PHOENIX_PORT=5000

# === Exposed ports (docker-compose.prod.yml stack) ===
PHOENIX_HTTP_PORT=80
PHOENIX_HTTPS_PORT=443

# === Image tag ===
PHOENIX_VERSION=4.0

# --- Chain of custody --------------------------------------------------------
# RFC 3161 Time Stamping Authority for checkpoints and reports (disabled if unset)
# PHOENIX_TSA_URL=
# PHOENIX_TSA_TIMEOUT=10
# Checkpoint store and optional Ed25519 signing key (PEM)
# PHOENIX_CUSTODY_DIR=
# PHOENIX_CUSTODY_SIGNING_KEY=
# Ledger entries between automatic checkpoints (0 disables)
# PHOENIX_CHECKPOINT_EVERY=100

# --- Investigator extensions -------------------------------------------------
# Push live attack graph updates (0 disables)
# PHOENIX_GRAPH_WATCH=1
# Roots indexed by the cross-case memory (paths separated by ':')
# PHOENIX_CASES_ROOT=
# Network capture analysis limits
# PHOENIX_PCAP_MAX_PACKETS=1000000
# PHOENIX_PCAP_MAX_CARVE_MB=25
# Maximum input size for deobfuscation (bytes)
# PHOENIX_DEOBF_MAX_BYTES=1048576

# --- Server and job queue ----------------------------------------------------
# Web threads of the single gunicorn worker (one per open WebSocket)
# PHOENIX_THREADS=64
# Investigation job workers and stale heartbeat delay (seconds)
# PHOENIX_JOB_WORKERS=2
# PHOENIX_JOB_STALE_SECONDS=120

# --- Tool sandbox and dual-LLM mode -------------------------------------------
# none | bwrap | docker (tools fail closed if the sandbox is unavailable)
# PHOENIX_TOOL_SANDBOX=none
# PHOENIX_SANDBOX_IMAGE=phoenix-dfir-tools:latest
# Quarantined extraction model for raw tool output
# PHOENIX_DUAL_LLM=false
# PHOENIX_EXTRACTOR_MODEL=
